# مثال متغيرات البيئة — من غير أي قيم حقيقية.
# انسخ الملف إلى .env.local للتشغيل المحلي. ممنوع لصق أسرار في الشات.

# إظهار صفحة /styleguide (للتطوير فقط). في الإنتاج اتركها فارغة.
ALLOW_STYLEGUIDE=1

# رابط الموقع العلني (دومين Railway بعد النشر) — لصور المشاركة فقط، ليس سرًا.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (يُنشأ المشروع يدويًا — راجع docs/DEPLOY.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (مفاتيح الاختبار للتطوير فقط)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# n8n (سيرفر منفصل — يُضبط لاحقًا)
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# مفتاح استدعاء عامل الصادر (يُولَّد بقيمة عشوائية طويلة)
OUTBOX_WORKER_KEY=

# إنشاء أول أدمن (تُستخدم في scripts/seed-admin.mjs مرة واحدة ثم تُحذف)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
